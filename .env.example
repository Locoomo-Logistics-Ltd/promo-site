# --- Google Sheets (primary database) ---
# Create a service account, enable the Google Sheets API, and SHARE the sheet with the
# service-account email as Editor. Keep the private key server-side only.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key. Keep the \n escapes inside the quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Registrations

# --- Resend (confirmation emails) ---
RESEND_API_KEY=
# Must be on a domain you have verified in Resend
EMAIL_FROM="Locoomo <christmas@your-verified-domain.com>"
EMAIL_REPLY_TO=info@locoomo.com

# --- Anti-fraud ---
# Long random string. IPs are stored as HMAC-SHA256 hashes keyed with this, never in plaintext.
IP_HASH_SECRET=
# Header your host sets with the real client IP (it must be set/overwritten by YOUR proxy):
#   Vercel: x-vercel-forwarded-for | Cloudflare: cf-connecting-ip | Nginx: x-real-ip | generic: x-forwarded-for
TRUSTED_IP_HEADER=x-forwarded-for
# Only for x-forwarded-for: number of trusted proxies in front of the app (the client IP is
# taken that many entries from the right of the list).
TRUSTED_PROXY_HOPS=1
# flag  = record the entry as NEEDS_REVIEW, send no automatic email, tell the user (default)
# block = reject outright, write no row, send no email
IP_POLICY=flag

# --- Admin dashboard (/admin) ---
# 32+ random characters; signs the admin session cookie. Generate: openssl rand -base64 48
ADMIN_SESSION_SECRET=
# LOCAL .env.local ONLY, never on the host: turns on /admin/invite so you can invite admins from your own
# computer (run `npm run dev`, set NEXT_PUBLIC_SITE_URL to the live site so invite links point there).
# ALLOW_ADMIN_INVITE=1

# --- Public ---
NEXT_PUBLIC_SUPPORT_EMAIL=info@locoomo.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Local testing only (ignored when NODE_ENV=production) ---
# MOCK_SERVICES=1
